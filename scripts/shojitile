#!/usr/bin/env bash

# Keqing-dots terminal control for ShojiWM (talks to its IPC socket)

deps socat jq perl || exit 1

SOCK="${XDG_RUNTIME_DIR:-/tmp}/shojiwm-${WAYLAND_DISPLAY:-wayland-0}.sock"

_json_str() { printf '"%s"' "${1//\"/\\\"}"; }

# Fire-and-forget: no "id" in the request, no response is sent back.
_send() { printf '%s\n' "$1" | socat -u - UNIX-CONNECT:"$SOCK" >/dev/null 2>&1; }

# Request/response: "id" included, read the single matching reply line back.
_query() { printf '%s\n' "$1" | socat -T 1 - UNIX-CONNECT:"$SOCK" 2>/dev/null | head -n1; }

_workspace_params() {
    [[ -n "$2" && -n "$3" ]] || { echo "usage: shojitile $1 <monitor> <index>" >&2; exit 1; }
    echo "\"monitor\":$(_json_str "$2"),\"index\":$3"
}

# Collapses jq's one-number-per-line array pretty-printing to one line, for
# fields that are just a coordinate/size pair.
_compact_pairs() {
    perl -0777 -pe 's/"(position|size)": \[\n\s*(-?\d+),\n\s*(-?\d+)\n\s*\]/"$1": [$2, $3]/g'
}

_windows_json() {
    _query '{"id":1,"method":"workspaces.get"}' | jq '
        [.result.monitors[] as $m |
         $m.workspaces[] as $w |
         $w.windows[] |
         {id, title, appId, monitor: $m.name, workspace: $w.index,
          active, urgent, monocle, position: [.position.x, .position.y], size: [.size.width, .size.height]}]
    ' | _compact_pairs
}

case "$1" in
    windows) _windows_json ;;
    activewindow) _windows_json | jq '.[] | select(.active)' | _compact_pairs ;;
    activeworkspace)
        _query '{"id":1,"method":"workspaces.get"}' | jq '
            [.result.monitors[] | {monitor: .name, workspace: .active}]
        '
        ;;
    switch) _send "{\"method\":\"workspaces.switch\",\"params\":{\"direction\":${2:-1}}}" ;;
    fw) _send "{\"method\":\"workspaces.activate\",\"params\":{$(_workspace_params fw "$2" "$3")}}" ;;
    mw)
        follow="true"
        [[ "$4" == "q" ]] && follow="false"
        _send "{\"method\":\"workspaces.moveWindow\",\"params\":{$(_workspace_params mw "$2" "$3"),\"follow\":$follow}}"
        ;;
    sw) _send "{\"method\":\"workspaces.swap\",\"params\":{$(_workspace_params sw "$2" "$3")}}" ;;
    mi) _send "{\"method\":\"workspaces.moveInto\",\"params\":{$(_workspace_params mi "$2" "$3")}}" ;;
    cw)
        if [[ "$2" == "a" ]]; then
            _send '{"method":"windows.closeAll"}'
        else
            _send '{"method":"windows.closeCurrent"}'
        fi
        ;;
    aw)
        [[ -n "$2" ]] || { echo "usage: shojitile aw <windowId>" >&2; exit 1; }
        _send "{\"method\":\"windows.activate\",\"params\":{\"windowId\":$(_json_str "$2")}}"
        ;;
    *) echo "usage: shojitile <windows|activewindow|activeworkspace|switch [-1|1]|fw <monitor> <index>|mw <monitor> <index> [q]|sw <monitor> <index>|mi <monitor> <index>|cw [a]|aw <windowId>>" >&2; exit 1 ;;
esac
